# ── Copy to .env.local (gitignored). Never commit real values. ──
# Firebase Auth email that counts as admin fallback (must exist in Firebase Auth
# with role:'admin' doc in users/{uid}, or match VITE_ADMIN_EMAIL check).
VITE_ADMIN_EMAIL=admin@foodmela.com

# DEV ONLY — local emergency login when Firebase Auth isn't configured.
# NEVER set VITE_DEV_ADMIN_BYPASS=true in production / Vercel.
VITE_DEV_ADMIN_BYPASS=false
VITE_DEV_ADMIN_PIN=change-me-locally-only
